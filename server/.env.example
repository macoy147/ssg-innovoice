PORT=5000
MONGODB_URI=your_mongodb_connection_string
NODE_ENV=development
LOG_LEVEL=info

# Security Settings
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
SESSION_SECRET=replace_with_a_long_random_64_character_hex_string
JWT_SECRET=replace_with_a_long_random_64_character_hex_string
SESSION_NAME=innovoice.sid

# Role-Based Access Control (Authorized SSG Officer Google Emails)
# Format: email:role:label:hexColor
ADMIN_EMAILS=president@gmail.com:executive:SSG President:#8b5cf6,developer@gmail.com:developer:Developer:#6366f1

# AI Settings (Groq - Free tier: 14,400 requests/day)
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Cloudinary Settings (Free tier: 25GB storage, 25GB bandwidth/month)
# Get your credentials at: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
# Google OAuth Settings
# Get your OAuth 2.0 Client ID at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
